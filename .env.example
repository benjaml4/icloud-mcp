# iCloud MCP Configuration
#
# ============================================================
# MODE SELECTION
# ============================================================
#
# LOCAL MODE (default): Uses AppleScript to access macOS apps
# - Faster (no network latency)
# - Works offline
# - Access to Reminders, Notes, Messages, Safari, Music, iCloud Drive (sync folder)
# - Requires macOS
#
# CLOUD MODE: Uses iCloud protocols (IMAP, CalDAV, CardDAV)
# - Works from any computer
# - Requires iCloud credentials
# - Only Email, Calendar, Contacts

USE_LOCAL_MODE=true    # Set to 'false' for cloud mode

# ============================================================
# CLOUD MODE CREDENTIALS (only needed if USE_LOCAL_MODE=false)
# ============================================================
#
# To get your app-specific password:
# 1. Go to https://appleid.apple.com
# 2. Sign in with your Apple ID
# 3. Security → App-Specific Passwords → Generate
# 4. Name it "iCloud MCP"
# 5. Copy the 16-character password below

ICLOUD_EMAIL=your-email@icloud.com
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ============================================================
# OPTIONAL
# ============================================================

# Timezone for date formatting (default: Europe/London)
# Use any IANA timezone name, e.g.:
#   TIMEZONE=America/New_York
#   TIMEZONE=Europe/Madrid
#   TIMEZONE=Asia/Tokyo
# Or set the standard TZ env var (takes precedence)
# TIMEZONE=Europe/London

# Date/time locale for formatting (default: en-GB)
# Use any BCP 47 locale tag, e.g.:
#   DATE_FORMAT=en-US
#   DATE_FORMAT=es-ES
#   DATE_FORMAT=ja-JP
# DATE_FORMAT=en-GB

# Enable test mode (uses mock data)
# USE_TEST_MODE=true

# Override iCloud Drive local sync path (default: ~/Library/Mobile Documents/com~apple~CloudDocs)
# ICLOUD_DRIVE_PATH=/Users/you/Library/Mobile Documents/com~apple~CloudDocs

# Optional: path to icloud-tools CLI (https://github.com/icanhasjonas/icloud-tools)
# Install: brew tap icanhasjonas/tap && brew install icloud-tools
# ICLOUD_CLI_PATH=/opt/homebrew/bin/icloud
